{
  "title": "ShopStream on ClickHouse",
  "uid": "shopstream",
  "schemaVersion": 39,
  "time": {
    "from": "2026-06-01T00:00:00Z",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "row",
      "title": "ShopStream business view (ClickHouse queries)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Events per minute (all shops)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT minute AS time, countMerge(events) AS events FROM shop.events_per_minute WHERE $__timeFilter(minute) GROUP BY time ORDER BY time"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Revenue per hour",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toStartOfHour(minute) AS time, sumMerge(revenue) AS revenue FROM shop.events_per_minute WHERE $__timeFilter(minute) GROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "type": "barchart",
      "title": "Funnel (last 7 days of data)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT event_type, count() AS events, uniq(user_id) AS shoppers FROM shop.events_all WHERE event_time > (SELECT max(event_time) FROM shop.events_all) - INTERVAL 7 DAY AND event_type IN ('page_view','add_to_cart','purchase') GROUP BY event_type ORDER BY events DESC"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top 10 shops by revenue",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT tenant_id AS shop, count() AS events, sum(revenue) AS revenue FROM shop.events_all GROUP BY shop ORDER BY revenue DESC LIMIT 10"
        }
      ]
    },
    {
      "type": "row",
      "title": "Cluster health (Prometheus)",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Inserted rows / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ClickHouseProfileEvents_InsertedRows[1m])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Max parts per partition",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
